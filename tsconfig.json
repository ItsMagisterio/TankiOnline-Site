{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    // Подключает типы Vite (клиентские импорты, env-переменные):
    "types": ["vite/client"]
  },
  // Включаем файлы конфигурации, чтобы IDE не ругалась на них:
  "include": ["src", "vite.config.js", "vite.config.ts"]
}
